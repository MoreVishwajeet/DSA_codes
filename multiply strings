class Solution {
public:
    string multiply(string num1, string num2) {
        if(num1=="0"||num2=="0") return "0";
        
        int n = num1.size();
        int m = num2.size();

        vector<int> result(n+m , 0);
        for(int i=n-1; i>=0; i--){
            for(int j=m-1; j>=0; j--){
                long mul = (num1[i]-'0')*(num2[j]-'0') + result[i+j+1];
                result[i+j+1] = mul % 10;
                result[i+j] += mul / 10;

            }
        }

        string ans = "";
        for (int i : result) {
            if (!(ans.empty() && i==0)) {
                ans.push_back(i + '0');
            }
        }

        return ans;
    }
};
